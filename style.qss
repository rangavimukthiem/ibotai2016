/* Global Styles */
QWidget {
    background-color: #A3D1C6;
    font-family: "Arial";
    font-size: 14px;
    color: #333;
}

/* QLabel Styles */
QLabel {
    color: #444;
    font-weight: bold;
    font-size: 15px;  /* Fixed missing semicolon */
    padding: 10px;
    margin: 10px;
    background-color: #d2fae7;
    border-radius: 8px;
}

/* QTextEdit Styles */
QTextEdit, QPlainTextEdit {
    background-color: #d2fae7;
    color: #444;
    border: 1px solid #26355D;
    font-family: "Courier New";
    padding: 5px;
    font-size:18px;

}

/* Overlay Widget */
QWidget#OverlayWidget {
    background-color: rgba(10, 10, 30, 50);
    border-radius: 10px;
    color: white;
    font-size: 16px;
}

/* QPushButton Styles */
QPushButton {
    background-color: #3CAF50;  /* Green background */
    color: white;               /* White text */
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 5px;
    transition: background-color 0.3s ease;
}

QPushButton:hover {
    background-color: #45a049;
}

QPushButton:pressed {
    background-color: #388e3c;
}

/* QComboBox Styles */
QComboBox {
    background-color: #fff;
    padding: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background: #fff;
    selection-color: white;
    selection-background-color: #4CAF50;
}

/* QLabel Styles for Combo Box Title */
QLabel[role='combo_box_label'] {
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 5px;
}

/* Camera Label Border */
QLabel[role='camera_label'] {
    border: 2px solid black;
    background-color: #f0f0f0;
}

/* Scrollbars for QTextEdit */
QScrollBar:vertical {
    background: #ddd;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #888;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
}

/* Unique Styles for Specific Buttons */
QPushButton#backButton {
    background-color: #F44336; /* Red */
}

QPushButton#backButton:hover {
    background-color: #D32F2F; /* Darker Red */
}

QPushButton#navigationButtons {
    background-color: #F44336; /* Red */
}

QPushButton#navigationButtons:hover {
    background-color: #D32F2F; /* Darker Red */
}
QPushButton#navigationButtons:active {
    background-color: #c32F2F; /* Darker Red */
}
